{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ninelabs",
  "main": "custom-worker.js",
  "workers_dev": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  // Custom Domains (Cloudflare makes the DNS record + certificate). The zones must be on this account first.
  // Which host serves what: src/lib/host-route.ts.
  "routes": [
    { "pattern": "ninelabsolutions.ae", "custom_domain": true },
    { "pattern": "www.ninelabsolutions.ae", "custom_domain": true },
    { "pattern": "admin.ninelabsolutions.ae", "custom_domain": true },
    { "pattern": "www.admin.ninelabsolutions.ae", "custom_domain": true },
    { "pattern": "ninelabsolutions.com", "custom_domain": true },
    { "pattern": "www.ninelabsolutions.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // the deploy's id: the edge-cache key carries it, so a new deploy never serves pages built for the old one
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true
  }
}
