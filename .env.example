# Copy to .env and fill in. Never commit the real .env file.

# --- required ---------------------------------------------------------------
# A long random string (32+ characters). Signs sessions and download links.
PAYLOAD_SECRET=
# Public address of the website (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- admin sign-in ----------------------------------------------------------
# Google e-mails that are created as owners on first start (comma separated).
ADMIN_EMAILS=
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: <admin address>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Hostname of the admin, e.g. admin.example.com. When set, the admin only answers on this
# hostname and the public site returns "not found" for /admin. Leave empty locally.
ADMIN_HOST=
# Full address of the admin, e.g. https://admin.example.com (used in e-mails and sign-in redirects).
NEXT_PUBLIC_ADMIN_URL=

# --- e-mail (the mailbox that comes with the domain) -------------------------
# Leave SMTP_HOST empty in development: e-mails are then saved to data/outbox/ instead of sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Nine Labs Solutions

# --- visitors ---------------------------------------------------------------
# How many proxies sit in front of the app (1 = just the host's own; 2 = a CDN such as
# Cloudflare in front of it). Used to read each visitor's address for the forms' limits.
TRUSTED_PROXY_HOPS=1

# --- storage ----------------------------------------------------------------
# SQLite database file. Default: file:./data/ninelabs.db
DATABASE_URI=

# --- optional: Cloudflare Turnstile on the public forms -----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
