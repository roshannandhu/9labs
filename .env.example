# Copy to .env.local and fill in. Never commit the real file.

# --- public (read at build time and in the browser) --------------------------
# Public address of the website (no trailing slash). http://localhost:3002 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Supabase project (Settings → API). The publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "1" in development only: shows the admin's "Load sample data" button.
NEXT_PUBLIC_SAMPLE_SEED=

# --- database & auth (server only) -------------------------------------------
# Supabase secret key (Settings → API → Secret keys). Full access — never expose this.
SUPABASE_SECRET_KEY=
# A long random string (48+ characters). Signs download links and hashes visitor IPs.
APP_SECRET=
# The first owner(s), comma separated. Used only while the admins table is empty.
ADMIN_EMAILS=

# --- storage: Cloudflare R2 ---------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- e-mail (SMTP) ------------------------------------------------------------
# Leave SMTP_HOST empty to only log e-mails in the admin instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Nine Labs Solutions

# --- automation ----------------------------------------------------------------
# A long random string (32+ characters). Authorizes the scheduled retry endpoint.
CRON_SECRET=
# "1" in development only: enables the admin's sample-data endpoint.
ALLOW_SAMPLE_SEED=

# AI quiz (docs/AI_RAG_SYSTEM.md). Without keys the quiz uses the built-in backup result.
# Several keys per provider: comma-separated — a rate-limited key hands over to the next.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides (model ids change often):
GROQ_MODEL=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
AI_DAILY_CAP=
