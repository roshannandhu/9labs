# Production site URL (used for sitemap.xml, robots.txt, canonical links, and OpenGraph images)
# Replace with your actual live domain (e.g. https://ninelabssolutions.com or https://ninelabs.ae)
NEXT_PUBLIC_SITE_URL=https://ninelabssolutions.com

# Base path for deployment on subpaths (e.g. /9labs/ on GitHub Pages, or leave empty for root domain)
NEXT_BASE_PATH=

# Set to 1 to block search engine indexing on staging/preview environments
# NEXT_PUBLIC_NOINDEX=1
